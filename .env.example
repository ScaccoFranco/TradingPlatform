# Copiare in .env e riempire: il file .env non va mai committato.
# Chiavi del paper trading Alpaca, ottenibili da https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Deve restare true: il codice live si rifiuta di partire sul trading reale.
ALPACA_PAPER=true
# Alert opzionali: senza queste due variabili il sistema logga soltanto.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
